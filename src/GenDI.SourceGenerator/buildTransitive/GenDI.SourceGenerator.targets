<Project>
	<Target Name="UnlockTransitiveAnalyser" BeforeTargets="_GenerateProjectLintProperties;GetCopyOutputDirectoryItems">
		<ItemGroup>
			<PackageReference Update="GenDI.SourceGenerator">
				<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
				<PrivateAssets>contentfiles; compile; runtime</PrivateAssets>
			</PackageReference>
		</ItemGroup>
	</Target>
</Project>