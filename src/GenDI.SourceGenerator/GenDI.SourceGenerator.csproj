<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../pack.props" />
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <OutputItemType>Analyzer</OutputItemType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);RS2008;NU5128</NoWarn>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference
      Include="Microsoft.CodeAnalysis.CSharp"
      Version="4.*"
      PrivateAssets="all"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="../GenDI.Analyzers/GenDI.Analyzers.csproj"
      PrivateAssets="all"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="$(OutputPath)$(AssemblyName).dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
    <None
      Include="$(MSBuildThisFileDirectory)..\GenDI.Analyzers\bin\$(Configuration)\$(TargetFramework)\GenDI.Analyzers.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
    <None Include="../../README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" Visible="false" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="icon.png" Visible="false" />
    <None
      Include="buildTransitive/GenDI.SourceGenerator.props"
      Pack="true"
      PackagePath="buildTransitive/GenDI.SourceGenerator.props"
      Visible="false"
    />
  </ItemGroup>
</Project>
