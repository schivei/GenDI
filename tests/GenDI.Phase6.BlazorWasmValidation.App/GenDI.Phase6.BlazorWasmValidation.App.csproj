<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.*" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Sdk.WebAssembly.Pack" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/GenDI/GenDI.csproj" PrivateAssets="all" />
    <ProjectReference
      Include="../../src/GenDI.Analyzers/GenDI.Analyzers.csproj"
      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"
      PrivateAssets="compile; runtime; contentfiles"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference
      Include="../../src/GenDI.SourceGenerator/GenDI.SourceGenerator.csproj"
      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"
      PrivateAssets="compile; runtime; contentfiles"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
