<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PublishTrimmed Condition="'$(GenDI_EnableTrimPublish)' == 'true'">true</PublishTrimmed>
    <TrimMode Condition="'$(GenDI_EnableTrimPublish)' == 'true'">full</TrimMode>
    <TargetLatestRuntimePatch Condition="'$(GenDI_EnableTrimPublish)' == 'true'">false</TargetLatestRuntimePatch>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/GenDI/GenDI.csproj" />
    <ProjectReference
      Include="../../src/GenDI.SourceGenerator/GenDI.SourceGenerator.csproj"
      PrivateAssets="all"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="ILLink.xml" />
  </ItemGroup>
</Project>
