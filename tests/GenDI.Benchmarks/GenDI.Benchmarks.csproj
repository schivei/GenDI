<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <PublishAot Condition="'$(AotBenchmark)' == 'true'">true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.*" />

    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.*" />
    <PackageReference
      Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="10.*"
    />
    <PackageReference
      Include="Microsoft.Extensions.Options.ConfigurationExtensions"
      Version="10.*"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/GenDI/GenDI.csproj" PrivateAssets="all" />
    <ProjectReference
      Include="../../src/GenDI.Analyzers/GenDI.Analyzers.csproj"
      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"
      PrivateAssets="compile; runtime; contentfiles"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference
      Include="../../src/GenDI.SourceGenerator/GenDI.SourceGenerator.csproj"
      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"
      PrivateAssets="compile; runtime; contentfiles"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
